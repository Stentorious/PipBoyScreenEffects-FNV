int iStateCache
int iStateTemp
int iStateWater
float fTimer
float fPlrHealth
float fPlrArmor
float fHealthThreshold
float fArmorThreshold
ref rArmor
ref rWeather

Begin Function {}

	if eval ModelHasBlock Player "glare" == 0
		return
	endif

	; Validate mesh
	if eval Goo1.AuxVarGetFlt "*PipScreen_INI" 2 == 0 && ModelHasBlock Player "ScreenEffectOverlay" == 0
		AttachModel Player 3 "glare|PipBoyScreenEffects\Default.nif"
	endif

	; Update brightness
	Player.SetMatrPropVal "*PipScreen:Blood" 8 (Goo1.AuxVarGetFlt "*PipScreen:Blood" 1)
	Player.SetMatrPropVal "*PipScreen:Crack" 8 (Goo1.AuxVarGetFlt "*PipScreen:Crack" 1)
	Player.SetMatrPropVal "*PipScreen:Water" 8 (Goo1.AuxVarGetFlt "*PipScreen:Water" 1)
	Player.SetMatrPropVal "*PipScreen:Dust" 8 (Goo1.AuxVarGetFlt "*PipScreen:Dust" 1)

	; Armor condition (Cracks)
	if eval Goo1.AuxVarGetFlt "*PipScreen:Crack" 0

		iStateCache = Goo1.AuxVarGetFlt "*PipScreen:Crack" 3
		fArmorThreshold = (Goo1.AuxVarGetFlt "*PipScreen_INI" 1) / 100

		; Check state
		if eval IsReference (rArmor = Player.GetEquippedItemRef 2) && (fPlrArmor = rArmor.GetItemRefCurrentHealth 1) < fArmorThreshold
			iStateTemp = 2 - (Flr (fPlrArmor / (fArmorThreshold / 2)))

			; Update texture
			if eval iStateTemp != iStateCache
				SwapTextureEx Player "*PipScreen:Crack" (sv_Construct "PipBoyScreenEffects\crack_%g" iStateTemp) 0
				Player.SetMatrPropVal "*PipScreen:Crack" 7 1
				Goo1.AuxVarSetFlt "*PipScreen:Crack" iStateTemp 3
			endif

		elseif eval iStateTemp != iStateCache
			Player.SetMatrPropVal "*PipScreen:Crack" 7 0
			Goo1.AuxVarSetFlt "*PipScreen:Crack" iStateTemp 3
		endif

	endif


	; Water
	if eval Goo1.AuxVarGetFlt "*PipScreen:Water" 0

		; Check state
		if eval Player.GetWaterImmersionPerc > 0.875
			iStateWater = 2
		elseif eval IsRaining && Player.IsInInterior == 0
			iStateWater = 1
		endif

		; Init Fade
		if eval iStateWater != Goo1.AuxVarGetFlt "*PipScreen:Water" 3

			; Wash other effects
			if eval iStateWater > 0
				if eval iStateWater == 1
					fTimer = 5
				else
					fTimer = 2
				endif

				; Fade blood
				if eval Player.GetMatrPropVal "*PipScreen:Blood" 7 > 0
					Goo1.AuxVarSetFlt "*PipScreen:Blood" fTimer 2
					Call (CompileScript "PipBoyScreenEffects\EffectTimerStart.gek") "*PipScreen:Blood" 0
				endif

				; Fade dust
				if eval Player.GetMatrPropVal "*PipScreen:Dust" 7 > 0
					Goo1.AuxVarSetFlt "*PipScreen:Dust" fTimer 2
					Call (CompileScript "PipBoyScreenEffects\EffectTimerStart.gek") "*PipScreen:Dust" 0
				endif

			endif

			Call (CompileScript "PipBoyScreenEffects\EffectTimerStart.gek") "*PipScreen:Water" iStateWater
		endif

	endif


	; Dust
	if eval Goo1.AuxVarGetFlt "*PipScreen:Dust" 0

		iStateTemp = (eval IsFormValid (rWeather = GetCurrentWeather) && HasKeyWord rWeather "WeatherSandstorm" && iStateWater == 0)
		if eval iStateTemp != Goo1.AuxVarGetFlt "*PipScreen:Dust" 3
			Goo1.AuxVarSetFlt "*PipScreen:Dust" 30 2
			Call (CompileScript "PipBoyScreenEffects\EffectTimerStart.gek") "*PipScreen:Dust" iStateTemp
		endif

	endif

end