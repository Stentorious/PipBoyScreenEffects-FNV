int iStateCache
int iStateTemp
int iStateWater
float fTimer
float fPlrHealth
float fPlrArmor
float fHealthThreshold
float fArmorThreshold
ref rArmor
ref rWeather

Begin Function {}

	if eval ModelHasBlock Player "ScreenEffectOverlay" == 0
		return
	endif

	; Armor condition (Cracks)
	if eval Goo1.AuxVarGetFlt "*PipScreen:Crack" 0

		iStateCache = Goo1.AuxVarGetFlt "*PipScreen:Crack" 4
		fArmorThreshold = (Goo1.AuxVarGetFlt "*PipScreen:Crack" 3) / 100

		; Check state
		if eval IsReference (rArmor = Player.GetEquippedItemRef 2) && (fPlrArmor = rArmor.GetItemRefCurrentHealth 1) < fArmorThreshold
			iStateTemp = 2 - (Flr (fPlrArmor / (fArmorThreshold / 2)))

			; Update texture
			if eval iStateTemp != iStateCache
				SwapTextureEx Player "*PipScreen:Crack" (sv_Construct "PipBoyScreenEffects\crack_%g" iStateTemp) 0
				Player.SetMatrPropVal "*PipScreen:Crack" 7 1
				Goo1.AuxVarSetFlt "*PipScreen:Crack" iStateTemp 4
			endif

		elseif eval iStateTemp != iStateCache
			Player.SetMatrPropVal "*PipScreen:Crack" 7 0
			Goo1.AuxVarSetFlt "*PipScreen:Crack" iStateTemp 4
		endif

	endif


	; Water
	if eval Goo1.AuxVarGetFlt "*PipScreen:Water" 0

		; Check state
		if eval Player.GetWaterImmersionPerc > 0.875
			iStateWater = 2
		elseif eval IsRaining && Player.IsInInterior == 0
			iStateWater = 1
		endif

		; Init Fade
		if eval iStateWater != Goo1.AuxVarGetFlt "*PipScreen:Water" 4

			; Wash other effects
			if eval iStateWater

				; Fade time
				fTimer = Goo1.AuxVarGetFlt "*PipScreen:Water" 3
				if eval iStateWater == 2
					fTimer /= 2
				endif

				; Fade blood
				if eval Player.GetMatrPropVal "*PipScreen:Blood" 7 > 0
					Goo1.AuxVarSetFlt "*PipScreen:Blood" fTimer 5
					Call (CompileScript "PipBoyScreenEffects\EffectTimerStart.gek") "*PipScreen:Blood" 0
				endif

				; Fade dust
				if eval Player.GetMatrPropVal "*PipScreen:Dust" 7 > 0
					Goo1.AuxVarSetFlt "*PipScreen:Dust" fTimer 5
					Call (CompileScript "PipBoyScreenEffects\EffectTimerStart.gek") "*PipScreen:Dust" 0
				endif

			endif

			Call (CompileScript "PipBoyScreenEffects\EffectTimerStart.gek") "*PipScreen:Water" iStateWater
		endif

	endif


	; Dust
	if eval Goo1.AuxVarGetFlt "*PipScreen:Dust" 0

		iStateTemp = (eval IsFormValid (rWeather = GetCurrentWeather) && HasKeyWord rWeather "WeatherSandstorm" && Player.IsInInterior == 0 && iStateWater == 0)
		if eval iStateTemp != Goo1.AuxVarGetFlt "*PipScreen:Dust" 4
			Goo1.AuxVarSetFlt "*PipScreen:Dust" (Goo1.AuxVarGetFlt "*PipScreen:Dust" 2) 5
			Call (CompileScript "PipBoyScreenEffects\EffectTimerStart.gek") "*PipScreen:Dust" iStateTemp
		endif

	endif

end