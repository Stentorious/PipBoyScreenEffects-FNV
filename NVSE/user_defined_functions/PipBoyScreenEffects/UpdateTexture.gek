int iArmorState
float fPlrHealth
float fPlrArmor
float fHealthThreshold
float fArmorThreshold
ref rArmor
ref rWeather
array_var aTextureSet
string_var sTexture

Begin Function {}

	if eval ModelHasBlock Player "glare:0" == 0
		return
	endif

	sTexture = "Stentorious\PipBoyScreenEffects\"

	fHealthThreshold = (Goo1.AuxVarGetFlt "*PipScreen_INI" 4) / 100
	fArmorThreshold = (Goo1.AuxVarGetFlt "*PipScreen_INI" 5) / 100

	if eval Goo1.AuxVarGetFlt "*PipScreen_INI" 2 && ((IsRaining && Player.IsInInterior == 0) || Player.GetWaterImmersionPerc > 0.875)
		AuxTimerStart "*PipScreen_Water" (Goo1.AuxVarGetFlt "*PipScreen_INI" 6) 14
	endif

	if eval AuxTimerTimeLeft "*PipScreen_Water" != -1
		sTexture += "wet\1_"
	elseif eval Goo1.AuxVarGetFlt "*PipScreen_INI" 0 && (fPlrHealth = Player.GetHealthPercentage) < fHealthThreshold
		sTexture = sv_Construct "%zblood\%g_" sTexture (4 - (Flr (fPlrHealth / (fHealthThreshold / 4))))
	elseif eval Goo1.AuxVarGetFlt "*PipScreen_INI" 3 && IsFormValid (rWeather = GetCurrentWeather) && HasKeyWord rWeather "WeatherSandstorm"
		sTexture += "dust\1_"
	else
		sTexture += "crack\"
	endif

	; Armor condition (Cracks)
	if eval Goo1.AuxVarGetFlt "*PipScreen_INI" 1 && IsReference (rArmor = Player.GetEquippedItemRef 2) && (fPlrArmor = rArmor.GetItemRefCurrentHealth 1) < fArmorThreshold
		iArmorState = 2 - (Flr (fPlrArmor / (fHealthThreshold / 2)))
	endif
	sTexture += $iArmorState

	aTextureSet = Player.GetBlockTextureSet "glare:0"

	if eval (aTextureSet[0]) == ("textures\" + (sTexture) + ".dds")
		aTextureSet = ar_Null
		sv_Destruct sTexture
		return
	endif

	SwapTextureEx Player "glare:0" (sTexture) 0

	aTextureSet = ar_Null
	sv_Destruct sTexture

end