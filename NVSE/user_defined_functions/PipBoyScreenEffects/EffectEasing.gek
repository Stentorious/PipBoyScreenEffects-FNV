float fTimeDelta
ref rOwner
string_var sTimerName

float fValue

Begin Function {sTimerName, rOwner, fTimeDelta}

	; Update value
	fValue = AuxTimerTimeLeft (sTimerName) / (Goo1.AuxVarGetFlt (sTimerName) 5)
	if eval Goo1.AuxVarGetFlt (sTimerName) 4 > 0
		fValue = 1 - fValue
	endif
	Player.SetMatrPropVal (sTimerName) 7 fValue

	sv_Destruct sTimerName

end