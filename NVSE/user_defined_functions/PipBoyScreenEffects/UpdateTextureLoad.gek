int iStateTemp
int iStateWater
float fPlrHealth
float fPlrArmor
float fHealthThreshold
float fArmorThreshold
ref rArmor
ref rWeather

Begin Function {}

	AuxTimerStop "*PipScreen:Blood" 0
	AuxTimerStop "*PipScreen:Crack" 0
	AuxTimerStop "*PipScreen:Water" 0
	AuxTimerStop "*PipScreen:Dust" 0

	if eval ModelHasBlock Player "glare" == 0
		return
	endif

	; Validate mesh
	if eval Goo1.AuxVarGetFlt "*PipScreen_INI" 2 == 0 && ModelHasBlock Player "ScreenEffectOverlay" == 0
		AttachModel Player 3 "glare|PipBoyScreenEffects\Default.nif"
	endif

	; Armor condition (Cracks)
	if eval Goo1.AuxVarGetFlt "*PipScreen:Crack" 0
		fArmorThreshold = (Goo1.AuxVarGetFlt "*PipScreen_INI" 1) / 100
		if eval IsReference (rArmor = Player.GetEquippedItemRef 2) && (fPlrArmor = rArmor.GetItemRefCurrentHealth 1) < fArmorThreshold
			iStateTemp = 2 - (Flr (fPlrArmor / (fArmorThreshold / 2)))
			SwapTextureEx Player "*PipScreen:Crack" (sv_Construct "PipBoyScreenEffects\crack_%g" iStateTemp) 0
			Player.SetMatrPropVal "*PipScreen:Crack" 7 1
			Goo1.AuxVarSetFlt "*PipScreen:Crack" iStateTemp 3
		else
			Player.SetMatrPropVal "*PipScreen:Crack" 7 0
			Goo1.AuxVarSetFlt "*PipScreen:Crack" 0 3
		endif
	endif

	; Water
	if eval Goo1.AuxVarGetFlt "*PipScreen:Water" 0
		iStateWater = (eval Player.GetWaterImmersionPerc > 0.875 || (IsRaining && Player.IsInInterior == 0))
		Goo1.AuxVarSetFlt "*PipScreen:Water" iStateWater 3
		Player.SetMatrPropVal "*PipScreen:Water" 7 iStateWater
	endif

	; Dust
	if eval Goo1.AuxVarGetFlt "*PipScreen:Dust" 0
		iStateTemp = (eval IsFormValid (rWeather = GetCurrentWeather) && HasKeyWord rWeather "WeatherSandstorm" && Player.IsInInterior == 0 && iStateWater == 0)
		Goo1.AuxVarSetFlt "*PipScreen:Dust" iStateTemp 3
		Player.SetMatrPropVal "*PipScreen:Dust" 7 iStateTemp
	endif

	; Blood
	Player.SetMatrPropVal "*PipScreen:Blood" 7 0

end